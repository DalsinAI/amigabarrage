AMIGA_STOVE ?=

ifeq ($(strip $(AMIGA_STOVE)),)
$(error Set AMIGA_STOVE to the os32-gcc16 stove directory)
endif

PREFIX   := $(AMIGA_STOVE)/prefix
SYSROOT  := $(PREFIX)/m68k-amigaos
CC       := $(PREFIX)/bin/m68k-amigaos-gcc
OBJDIR   := build/amigaos3/obj
OUTDIR   := build/amigaos3
PROGRAM  := $(OUTDIR)/Barrage
LAUNCHER := $(OUTDIR)/BarrageLauncher
FULLSCREEN_LAUNCHER := $(OUTDIR)/BarrageFullscreen

SOURCES := \
	src/main.c \
	src/particle.c \
	src/shots.c \
	src/units.c \
	src/data.c \
	src/chart.c \
	src/bfield.c \
	src/menu.c \
	src/SFont.c

OBJECTS := $(SOURCES:src/%.c=$(OBJDIR)/%.o)

CPPFLAGS := -Isrc -I$(SYSROOT)/include/SDL2 \
	-DAMIGAOS3 -DAUDIO_ENABLED \
	-DVERSION=\"1.0.4-amiga1-rc1\" -DSRC_DIR=\"PROGDIR:data\"
CFLAGS := -std=gnu99 -O2 -Wall -Wextra -Wno-unused-parameter \
	-m68040 -m68881 -noixemul -fno-delete-null-pointer-checks
LDFLAGS := -m68040 -m68881 -noixemul -L$(SYSROOT)/lib
LDLIBS := -lSDL2_mixer -lSDL2 -lm -lamiga

.PHONY: all clean

all: $(PROGRAM) $(LAUNCHER) $(FULLSCREEN_LAUNCHER)

$(PROGRAM): $(OBJECTS) | $(OUTDIR)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)

$(LAUNCHER): amigaos3/launcher.c | $(OUTDIR)
	$(CC) -std=gnu99 -O2 -Wall -Wextra -m68040 -noixemul -o "$@" $< -lamiga

$(FULLSCREEN_LAUNCHER): amigaos3/launcher.c | $(OUTDIR)
	$(CC) -std=gnu99 -O2 -Wall -Wextra -m68040 -noixemul \
		-DBARRAGE_COMMAND=\"Barrage\" -o "$@" $< -lamiga

$(OBJDIR)/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(OUTDIR):
	@mkdir -p $@

clean:
	rm -rf build/amigaos3
